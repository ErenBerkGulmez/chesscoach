# Chess Coach

# === Application ===
NODE_ENV=development
PORT=3001

# === Database ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess_coach?schema=public"

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Chess.com API ===
CHESSCOM_USER_AGENT="ChessCoach/1.0 (contact: your-email@example.com)"

# === Stockfish ===
STOCKFISH_DEPTH=20
STOCKFISH_MULTI_PV=3
STOCKFISH_THREADS=2

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="Chess Coach"
